# Railway PostgreSQL connection string.
# Use the Railway PostgreSQL public/external URL when connecting from Vercel.
DATABASE_URL=""

# Auth.js / NextAuth production URL.
# Set both values to the final Vercel deployment URL, for example:
# AUTH_URL="https://your-project.vercel.app"
# NEXTAUTH_URL="https://your-project.vercel.app"
AUTH_URL=""
NEXTAUTH_URL=""

# Strong random secrets for Auth.js / NextAuth.
# Generate with: openssl rand -base64 32
# The current codebase uses Auth.js v5 and requires AUTH_SECRET.
# NEXTAUTH_SECRET is included for compatibility with NextAuth naming.
AUTH_SECRET=""
NEXTAUTH_SECRET=""
