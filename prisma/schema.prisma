generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  SUPER_ADMIN
  PROJECT_MANAGER
  DESIGNER
  MARKETER
  DEVELOPER
  VIEWER
}

enum FileCategory {
  LOGO
  BRAND_IDENTITY
  PRODUCT_IMAGE
  SERVICE_ATTACHMENT
  REFERENCE
  DELIVERABLE
  FINAL_FILE
  GENERAL
}

enum NotificationType {
  REQUEST_STATUS_CHANGED
  DELIVERABLE_UPLOADED
  COMMENT_ADDED
  REVISION_REQUESTED
  REQUEST_APPROVED
  ASSIGNMENT_CREATED
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ProductAvailability {
  AVAILABLE
  UNAVAILABLE
  COMING_SOON
}

enum RequestStatus {
  PENDING_REVIEW
  ACCEPTED
  IN_PROGRESS
  FIRST_LOOK_READY
  CLIENT_REVIEW
  REVISION_REQUESTED
  FINAL_LOOK_READY
  APPROVED
  DELIVERED
  ARCHIVED
}

enum RequestType {
  SOCIAL_MEDIA_CAMPAIGN
  DESIGN_POST
  MOTION_VIDEO
  LANDING_PAGE
  WEBSITE
  PAID_ADS_CAMPAIGN
  BRAND_IDENTITY
  PRODUCT_LAUNCH
  OFFER_CAMPAIGN
  EVENT_COVERAGE
  CONTENT_PLAN
  MONTHLY_PACKAGE
}

enum CampaignGoal {
  SALES
  BRAND_AWARENESS
  FOLLOWERS_GROWTH
  LEADS
  PRODUCT_LAUNCH
  OFFER_PROMOTION
  WEBSITE_TRAFFIC
  WHATSAPP_MESSAGES
}

enum Platform {
  INSTAGRAM
  TIKTOK
  SNAPCHAT
  X_TWITTER
  FACEBOOK
  GOOGLE_ADS
  WEBSITE
  WHATSAPP
  PRINT
  OUTDOOR_SCREENS
}

enum CreativeStyle {
  FORMAL
  PREMIUM
  YOUTHFUL
  BOLD
  EMOTIONAL
  FUNNY
  DIRECT
  STORYTELLING
  SAUDI_LOCAL
  GULF
  GLOBAL
}

enum RequestItemType {
  PRODUCT
  SERVICE
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DeliverableStatus {
  DRAFT
  FIRST_LOOK
  FINAL_LOOK
  APPROVED
  ARCHIVED
}

enum RevisionStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

model User {
  id                   String          @id @default(cuid())
  name                 String?
  email                String          @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?
  role                 UserRole        @default(CLIENT)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  clientProfile        ClientProfile?
  uploadedFiles        FileAsset[]     @relation("UploadedFiles")
  notifications        Notification[]
  assignedRequests     Assignment[]    @relation("AssignedRequests")
  createdAssignments   Assignment[]    @relation("CreatedAssignments")
  statusChanges        StatusHistory[] @relation("ChangedStatuses")
  uploadedDeliverables Deliverable[]   @relation("UploadedDeliverables")
  comments             Comment[]       @relation("UserComments")
  requestedRevisions   Revision[]      @relation("RequestedRevisions")

  @@index([role])
}

model ClientProfile {
  id               String            @id @default(cuid())
  userId           String            @unique
  companyName      String?
  country          String?
  city             String?
  onboardingStatus OnboardingStatus  @default(NOT_STARTED)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandProfile     BrandProfile?
  files            FileAsset[]
  products         Product[]
  services         Service[]
  campaignRequests CampaignRequest[]

  @@index([onboardingStatus])
}

model BrandProfile {
  id                  String            @id @default(cuid())
  clientProfileId     String            @unique
  brandName           String
  businessField       String?
  description         String?
  logoFileId          String?
  logoUrl             String?
  brandColors         String[]
  fonts               String[]
  visualIdentityNotes String?
  existingWebsite     String?
  targetAudience      String?
  toneOfVoice         String?
  brandDirection      String?
  marketingGoals      String[]
  likedExamples       String?
  dislikedExamples    String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  clientProfile       ClientProfile     @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  logoFile            FileAsset?        @relation("BrandLogo", fields: [logoFileId], references: [id], onDelete: SetNull)
  socialLinks         BrandSocialLink[]

  @@index([brandName])
}

model BrandSocialLink {
  id             String       @id @default(cuid())
  brandProfileId String
  platform       String
  url            String
  createdAt      DateTime     @default(now())
  brandProfile   BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)

  @@index([brandProfileId])
}

model Product {
  id              String                @id @default(cuid())
  clientProfileId String
  name            String
  description     String
  price           String?
  category        String?
  features        String[]
  availability    ProductAvailability   @default(AVAILABLE)
  targetAudience  String?
  purchaseLink    String?
  imageUrl        String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  clientProfile   ClientProfile         @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  requestItems    CampaignRequestItem[]

  @@index([clientProfileId, createdAt])
  @@index([availability])
}

model Service {
  id              String                @id @default(cuid())
  clientProfileId String
  name            String
  description     String
  price           String?
  duration        String?
  features        String[]
  targetAudience  String?
  attachmentUrl   String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  clientProfile   ClientProfile         @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  requestItems    CampaignRequestItem[]

  @@index([clientProfileId, createdAt])
}

model CampaignRequest {
  id                String                @id @default(cuid())
  clientProfileId   String
  title             String
  requestTypes      RequestType[]
  goals             CampaignGoal[]
  platforms         Platform[]
  creativeStyles    CreativeStyle[]
  mainMessage       String
  offer             String?
  requiredTexts     String?
  forbiddenElements String?
  competitors       String?
  references        String?
  language          String
  dialect           String?
  startDate         DateTime?
  deadline          DateTime?
  campaignDuration  String?
  isUrgent          Boolean               @default(false)
  urgentReason      String?
  status            RequestStatus         @default(PENDING_REVIEW)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  clientProfile     ClientProfile         @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  items             CampaignRequestItem[]
  assignments       Assignment[]
  statusHistory     StatusHistory[]
  deliverables      Deliverable[]
  comments          Comment[]

  @@index([clientProfileId, createdAt])
  @@index([status])
  @@index([deadline])
}

model CampaignRequestItem {
  id                String          @id @default(cuid())
  campaignRequestId String
  itemType          RequestItemType
  productId         String?
  serviceId         String?
  createdAt         DateTime        @default(now())
  campaignRequest   CampaignRequest @relation(fields: [campaignRequestId], references: [id], onDelete: Cascade)
  product           Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  service           Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([campaignRequestId])
  @@index([productId])
  @@index([serviceId])
}

model Assignment {
  id                String           @id @default(cuid())
  campaignRequestId String
  assignedToId      String
  assignedById      String
  roleLabel         String?
  status            AssignmentStatus @default(ACTIVE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  campaignRequest   CampaignRequest  @relation(fields: [campaignRequestId], references: [id], onDelete: Cascade)
  assignedTo        User             @relation("AssignedRequests", fields: [assignedToId], references: [id], onDelete: Cascade)
  assignedBy        User             @relation("CreatedAssignments", fields: [assignedById], references: [id], onDelete: Cascade)

  @@index([campaignRequestId, status])
  @@index([assignedToId, status])
  @@index([assignedById])
}

model StatusHistory {
  id                String          @id @default(cuid())
  campaignRequestId String
  oldStatus         RequestStatus?
  newStatus         RequestStatus
  changedById       String
  note              String?
  createdAt         DateTime        @default(now())
  campaignRequest   CampaignRequest @relation(fields: [campaignRequestId], references: [id], onDelete: Cascade)
  changedBy         User            @relation("ChangedStatuses", fields: [changedById], references: [id], onDelete: Cascade)

  @@index([campaignRequestId, createdAt])
  @@index([changedById])
  @@index([newStatus])
}

model Deliverable {
  id                String            @id @default(cuid())
  campaignRequestId String
  title             String
  description       String?
  versionLabel      String
  status            DeliverableStatus @default(DRAFT)
  uploadedById      String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  campaignRequest   CampaignRequest   @relation(fields: [campaignRequestId], references: [id], onDelete: Cascade)
  uploadedBy        User              @relation("UploadedDeliverables", fields: [uploadedById], references: [id], onDelete: Cascade)
  files             DeliverableFile[]
  comments          Comment[]
  revisions         Revision[]

  @@index([campaignRequestId, createdAt])
  @@index([uploadedById])
  @@index([status])
}

model DeliverableFile {
  id            String      @id @default(cuid())
  deliverableId String
  fileAssetId   String?
  fileUrl       String?
  filename      String
  fileType      String?
  fileSize      Int?
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  fileAsset     FileAsset?  @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)

  @@index([deliverableId, sortOrder])
  @@index([fileAssetId])
}

model Comment {
  id                String           @id @default(cuid())
  authorId          String
  campaignRequestId String?
  deliverableId     String?
  body              String
  parentCommentId   String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  author            User             @relation("UserComments", fields: [authorId], references: [id], onDelete: Cascade)
  campaignRequest   CampaignRequest? @relation(fields: [campaignRequestId], references: [id], onDelete: Cascade)
  deliverable       Deliverable?     @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  parentComment     Comment?         @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies           Comment[]        @relation("CommentReplies")

  @@index([authorId, createdAt])
  @@index([campaignRequestId, createdAt])
  @@index([deliverableId, createdAt])
  @@index([parentCommentId])
}

model Revision {
  id            String         @id @default(cuid())
  deliverableId String
  requestedById String
  notes         String
  status        RevisionStatus @default(OPEN)
  resolvedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deliverable   Deliverable    @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  requestedBy   User           @relation("RequestedRevisions", fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([deliverableId, status])
  @@index([requestedById])
}

model FileAsset {
  id               String            @id @default(cuid())
  ownerId          String
  clientProfileId  String?
  url              String
  key              String
  filename         String
  mimeType         String
  size             Int
  category         FileCategory      @default(GENERAL)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  owner            User              @relation("UploadedFiles", fields: [ownerId], references: [id], onDelete: Cascade)
  clientProfile    ClientProfile?    @relation(fields: [clientProfileId], references: [id], onDelete: SetNull)
  brandLogoFor     BrandProfile[]    @relation("BrandLogo")
  deliverableFiles DeliverableFile[]

  @@index([ownerId])
  @@index([clientProfileId])
  @@index([category])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  body       String?
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([type])
}
